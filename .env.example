# LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to run in replay-only mode.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Northwind world (run separately: python world_server.py)
WORLD_URL=http://127.0.0.1:7070

# Parallel runs: shared caps (free LLM tiers limit requests per minute per key)
WORKERS=4
LLM_PER_MINUTE=12
BILLING_PER_SECOND=4
USD_INR=84.0

# Per-run budgets
MAX_STEPS=25
MAX_SECONDS=300
MAX_TOKENS=200000
